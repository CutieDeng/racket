@@ -1532,6 +1532,18 @@
   (define init-file (expeditor-init-file-path))
   (when (file-exists? init-file)
     (dynamic-require init-file #f)))
+
+;; `racket-lexer` is exported through `contract-out`, so a `dynamic-require`
+;; of that name has to visit `syntax-color/racket-lexer` at phase 1 --
+;; instantiating the lexer generator's compile-time dependencies -- and
+;; then expand the identifier in a fresh namespace. `racket-lexer/status`
+;; is a plain variable export of the same lexer with one extra result, so
+;; request that one and drop the status.
+(define (default-racket-lexer)
+  (define lex/status (dynamic-require 'syntax-color/racket-lexer 'racket-lexer/status))
+  (lambda (in)
+    (let-values ([(lexeme type paren start end status) (lex/status in)])
+      (values lexeme type paren start end))))
 
 (define (expeditor-init-file-path)
   (define init-dir (find-system-path 'init-dir))
@@ -1552,7 +1564,7 @@
   (port-count-lines! (current-input-port))
