#lang racket/base
(require ffi/unsafe/vm '#%linklet racket/path)
(define case-id (string->symbol (vector-ref (current-command-line-arguments) 0)))
(define conv (vm-eval '(lambda (bv) (($primitive $vfasl-convert-bytevector) bv))))
(define rd (vm-eval '(lambda (bv ext) (fasl-read (open-bytevector-input-port bv) 'load ext))))
(define (try bv lits label)
  (printf "~a: ~a B, literals ~a ... " label (bytes-length bv) (vector-length lits)) (flush-output)
  (define vbv (conv bv))
  (printf "vfasl ~a B ... " (bytes-length vbv)) (flush-output)
  (rd vbv lits)
  (printf "ok\n"))
(define (linklet-of datum)
  (define lk (compile-linklet `(linklet () (x) (define-values (x) (quote ,datum))) 'test #f #f '(serializable)))
  (define-values (fmt bv lits) ((vm-eval 'linklet-fasled-code+arguments) lk))
  (values bv lits))
(define (synth datum label) (define-values (bv lits) (linklet-of datum)) (try bv lits label))
(case case-id
  [(real)
   (define src "/Users/cutiedeng/Library/Racket/9.3.10/pkgs/rackunit-lib/rackunit/private/base.rkt")
   (define ns (make-base-namespace))
   (define code (parameterize ([current-namespace ns] [read-accept-reader #t] [current-load-relative-directory (path-only src)])
                  (compile (call-with-input-file src (lambda (p) (port-count-lines! p) (read-syntax src p))))))
   (define bstr (let ([o (open-output-bytes)]) (parameterize ([current-write-relative-directory (path-only src)]) (write code o)) (get-output-bytes o)))
   (define c (parameterize ([read-accept-compiled #t]) (read (open-input-bytes bstr))))
   (define lk (hash-ref (linklet-bundle->hash (hash-ref (linklet-directory->hash c) #f)) 'decl))
   (define-values (fmt bv lits) ((vm-eval 'linklet-fasled-code+arguments) lk))
   (try bv lits "real decl")]
  [(ext-only) (synth (vector (hasheq)) "ext-only")]
  [(mbytes+ext) (synth (vector (bytes 1 2 3) (hasheq)) "mutable bytes + ext")]
  [(bigmbytes+ext) (synth (vector (make-bytes 300 7) (hasheq)) "300 mutable bytes + ext")]
  [(ibytes+ext) (synth (vector (bytes->immutable-bytes (bytes 1 2 3)) (hasheq)) "immutable bytes + ext")]
  [(syms+ext) (synth (vector 'a 'b "str" (hasheq)) "syms+str + ext")]
  [(mbytes-only) (synth (vector (bytes 1 2 3) 'a) "mutable bytes, no ext")]
  [(two-mbytes+ext) (synth (vector (bytes 1 2) (bytes 3 4 5) 'q (hasheq) (vector 'a 'b)) "two mutable bytes + vec + ext")])
(when (eq? case-id 'slice)
  (define-values (bv lits) (linklet-of (vector (hasheq))))
  (define vbv (conv bv))
  (define big (bytes-append (make-bytes 100 0) vbv (make-bytes 50 0)))
  (printf "slice at offset 100: ") (flush-output)
  ((vm-eval '(lambda (big lits) (let ([p (open-bytevector-input-port big)]) (set-port-position! p 100) (fasl-read p 'load lits)))) big lits)
  (printf "ok\n")
  (printf "slice at offset 0 of same big: ") (flush-output)
  (define big0 (bytes-append vbv (make-bytes 50 0)))
  ((vm-eval '(lambda (big lits) (let ([p (open-bytevector-input-port big)]) (fasl-read p 'load lits)))) big0 lits)
  (printf "ok\n"))
(when (eq? case-id 'pos)
  (define-values (bv lits) (linklet-of (vector (hasheq))))
  (define vbv (conv bv))
  (define big0 (bytes-append vbv (make-bytes 50 0)))
  (define pos-after (vm-eval '(lambda (big lits) (let ([p (open-bytevector-input-port big)]) (fasl-read p 'load lits) (port-position p)))))
  (printf "vfasl image ~a B: port position after fasl-read = ~a\n" (bytes-length vbv) (pos-after big0 lits))
  (define big1 (bytes-append bv (make-bytes 50 0)))
  (printf "plain fasl ~a B: port position after fasl-read = ~a\n" (bytes-length bv) (pos-after big1 lits)))
(when (eq? case-id 'realoff)
  (define src "/Users/cutiedeng/Library/Racket/9.3.10/pkgs/rackunit-lib/rackunit/private/base.rkt")
  (define ns (make-base-namespace))
  (define code (parameterize ([current-namespace ns] [read-accept-reader #t] [current-load-relative-directory (path-only src)])
                 (compile (call-with-input-file src (lambda (p) (port-count-lines! p) (read-syntax src p))))))
  (define bstr (let ([o (open-output-bytes)]) (parameterize ([current-write-relative-directory (path-only src)]) (write code o)) (get-output-bytes o)))
  (define c (parameterize ([read-accept-compiled #t]) (read (open-input-bytes bstr))))
  (define lk (hash-ref (linklet-bundle->hash (hash-ref (linklet-directory->hash c) #f)) 'decl))
  (define-values (fmt bv lits) ((vm-eval 'linklet-fasled-code+arguments) lk))
  (define vbv (conv bv))
  (define off (string->number (vector-ref (current-command-line-arguments) 1)))
  (define big (bytes-append (make-bytes off 0) vbv (make-bytes 64 0)))
  (printf "real decl vfasl ~a B at offset ~a: " (bytes-length vbv) off) (flush-output)
  ((vm-eval '(lambda (big off lits) (let ([p (open-bytevector-input-port big)]) (set-port-position! p off) (fasl-read p 'load lits)))) big off lits)
  (printf "ok\n"))
