(module p3-staddr-probe '#%kernel
  (#%require '#%linklet)
  (define-values (SP)
    "/private/tmp/claude-501/-Users-cutiedeng-Y2026-M07-D16-racket-feat-swisstable/d5d1ca89-29ba-48e9-9226-2d4a258a56cd/scratchpad")
  (define-values (P3) (string-append SP "/p3"))
  (define-values (chez-eval) (primitive-lookup 'eval))
  (define-values (sysw) (primitive-lookup 'call-with-system-wind))
  (define-values (ceval) (lambda (s) (sysw (lambda () (chez-eval s)))))
  (ceval (list 'load (string-append P3 "/p3.2-boot.chez.ss")))
  (ceval (list 'begin (list 'p32-load-into (string-append P3 "/p3.2-head.chez.ss"))))
  (ceval '(p32-in
           '(let ()
              (define (o . xs) (for-each display xs) (newline))
              (define sgen-p (try (lambda () ($primitive $generation)) #f))
              (define (sgen x) (if sgen-p (try (lambda () (sgen-p x)) 'GEN-ERR) 'NO-PRIM))
              (define a->o (try (lambda () ($primitive $address->object)) #f))
              (define fxaddr ($primitive $fxaddress))
              (define anchor (fxaddr ($ccode car)))
              (define (rel x) (- (fxaddr x) anchor))
              (define names '(car cdr cons vector-ref eval expand map assq
                              string-append symbol->string make-vector apply
                              values call-with-values dynamic-wind list->vector
                              vector->list number->string string->number append))
              (o "anchor(car code) gen=" (sgen ($ccode car)))
              (let ([cc ($ccode car)])
                (define (try-a2o label addr)
                  (o "  a2o " label ": "
                     (try (lambda ()
                            (let ([r (a->o addr 0)])
                              (if (eq? r cc) 'EQ-OK (obj-brief r))))
                          'ERR)))
                (let ([fa (fxaddr cc)])
                  (o "fxaddr=" fa)
                  (try-a2o "raw" fa)
                  (try-a2o "x8" (* 8 fa))
                  (try-a2o "x8+7" (+ (* 8 fa) 7))
                  (try-a2o "x8+1" (+ (* 8 fa) 1))
                  (try-a2o "x8+2" (+ (* 8 fa) 2))
                  (try-a2o "x8+5" (+ (* 8 fa) 5))))
              (o "gen of pair: " (sgen (cons 1 2)) "  gen of car-code: " (sgen ($ccode car)))
              (for-each
               (lambda (n)
                 (let ([p (top-level-value n (scheme-environment))])
                   (o n " code-rel=" (rel ($ccode p))
                      " gen=" (sgen ($ccode p)))))
               names)))))
