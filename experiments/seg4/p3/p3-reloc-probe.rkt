(module p3-reloc-probe '#%kernel
  (#%require '#%linklet)
  (define-values (SP)
    "/private/tmp/claude-501/-Users-cutiedeng-Y2026-M07-D16-racket-feat-swisstable/d5d1ca89-29ba-48e9-9226-2d4a258a56cd/scratchpad")
  (define-values (P3) (string-append SP "/p3"))
  (define-values (chez-eval) (primitive-lookup 'eval))
  (define-values (sysw) (primitive-lookup 'call-with-system-wind))
  (define-values (ceval) (lambda (s) (sysw (lambda () (chez-eval s)))))
  (ceval (list 'load (string-append P3 "/p3.2-boot.chez.ss")))
  (ceval (list 'begin (list 'p32-load-into (string-append P3 "/p3.2-head.chez.ss"))))
  (ceval '(p32-in
           '(let ()
              (define get-reloc
                (foreign-procedure "(cs)s_get_reloc"
                                   (scheme-object boolean) scheme-object))
              (define (o . xs) (for-each display xs) (newline))
              (define c ($ccode car))
              (define r (get-reloc c #f))
              (define c2 ($ccode eval))
              (define r2 (get-reloc c2 #f))
              (o "code: " (code-name c))
              (o "reloc type: " (cond [(vector? r) 'vector] [(list? r) 'list] [else r])
                 " len: " (if (vector? r) (vector-length r) (if (list? r) (length r) '?)))
              (when (vector? r)
                (let lp ([i 0])
                  (when (fx< i (fxmin 8 (vector-length r)))
                    (o "  [" i "] " (obj-brief (vector-ref r i)))
                    (lp (fx+ i 1)))))
              (o "eval reloc len: " (if (list? r2) (length r2) 'nonlist))
              (let lp ([l r2] [i 0])
                (when (and (pair? l) (fx< i 10))
                  (o "  eval-reloc[" i "] " (obj-brief (car l)))
                  (lp (cdr l) (fx+ i 1))))
              (o "done")))))
