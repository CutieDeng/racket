  (check-equal? (equal-secondary-hash-code pv)
                (equal-secondary-hash-code same))
  (define table (hash same 'found nested-a 'nested))
  (check-equal? (hash-ref table pv) 'found)
  (check-equal? (hash-ref table nested-b) 'nested))

