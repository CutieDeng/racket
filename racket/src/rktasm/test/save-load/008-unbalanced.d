;; ============================================================
;; 008-unbalanced.d - 栈不平衡警告测试
;; ============================================================
;;
;; 测试: 故意创建不平衡的栈操作，验证警告生成
;; 注意: 这个测试文件会产生警告，但代码仍然会生成

(: function test_unbalanced (export) (abi aapcs64))
(: label entry)
  (: save! all)
  (mov x29 sp)

  ;; 分配栈空间但不释放 - 应该产生警告
  (sub sp sp 64)

  ;; 注意：这里故意不 add sp sp 64

  (: load! all)  ;; 这里应该警告栈不平衡
  (ret)
(: end-function)
