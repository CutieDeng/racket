;; ============================================================
;; custom-aliases.rktd - 自定义别名定义
;; ============================================================
;;
;; 用于定义 MRS 中不存在但汇编器常用的简写形式
;;
;; 格式: (mnemonic (class signature) target-mnemonic transform)
;;   - class: 操作数类别 (c2, c3, c4, ...)
;;   - signature: 操作数类型签名
;;   - target-mnemonic: 目标指令助记符
;;   - transform: 转换规则
;;
;; 转换规则元素:
;;   - 数字 N: 使用别名的第 N 个操作数 (从 0 开始)
;;   - (const X): 常量值 X
;;   - (zr N): N 位零寄存器 (32 或 64)
;;

;; ------------------------------------------------------------
;; ROR 立即数: (ror Wd Wn #imm) -> (extr Wd Wn Wn #imm)
;; ------------------------------------------------------------
;; ROR 立即数形式是 EXTR 的别名，Rm = Rn
(ror (c3 (gpr-32 gpr-32 immediate)) extr (0 1 1 2))
(ror (c3 (gpr-64 gpr-64 immediate)) extr (0 1 1 2))

;; ------------------------------------------------------------
;; ADD 简写: (add Xd Xn Xm) -> (add Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
;; ARM64 的 ADD 指令寄存器形式需要移位操作数，但汇编器通常
;; 允许省略，默认为 LSL #0
(add (c3 (gpr-64 gpr-64 gpr-64)) add (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; SUB 简写: (sub Xd Xn Xm) -> (sub Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(sub (c3 (gpr-64 gpr-64 gpr-64)) sub (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; ADDS 简写: (adds Xd Xn Xm) -> (adds Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(adds (c3 (gpr-64 gpr-64 gpr-64)) adds (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; SUBS 简写: (subs Xd Xn Xm) -> (subs Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(subs (c3 (gpr-64 gpr-64 gpr-64)) subs (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; AND 简写: (and Xd Xn Xm) -> (and Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(and (c3 (gpr-64 gpr-64 gpr-64)) and (0 1 2 (const lsl) (const 0)))
(and (c3 (gpr-32 gpr-32 gpr-32)) and (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; ORR 简写: (orr Xd Xn Xm) -> (orr Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(orr (c3 (gpr-64 gpr-64 gpr-64)) orr (0 1 2 (const lsl) (const 0)))
(orr (c3 (gpr-32 gpr-32 gpr-32)) orr (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; EOR 简写: (eor Xd Xn Xm) -> (eor Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(eor (c3 (gpr-64 gpr-64 gpr-64)) eor (0 1 2 (const lsl) (const 0)))
(eor (c3 (gpr-32 gpr-32 gpr-32)) eor (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; BIC 简写: (bic Xd Xn Xm) -> (bic Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(bic (c3 (gpr-64 gpr-64 gpr-64)) bic (0 1 2 (const lsl) (const 0)))
(bic (c3 (gpr-32 gpr-32 gpr-32)) bic (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; ORN 简写: (orn Xd Xn Xm) -> (orn Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(orn (c3 (gpr-64 gpr-64 gpr-64)) orn (0 1 2 (const lsl) (const 0)))
(orn (c3 (gpr-32 gpr-32 gpr-32)) orn (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; EON 简写: (eon Xd Xn Xm) -> (eon Xd Xn Xm lsl 0)
;; ------------------------------------------------------------
(eon (c3 (gpr-64 gpr-64 gpr-64)) eon (0 1 2 (const lsl) (const 0)))
(eon (c3 (gpr-32 gpr-32 gpr-32)) eon (0 1 2 (const lsl) (const 0)))

;; ------------------------------------------------------------
;; CSET: (cset Wd cond) -> (csinc Wd WZR WZR invert(cond))
;; ------------------------------------------------------------
;; CSET 设置寄存器为 1 如果条件成立，否则为 0
;; 实现为 CSINC 的别名，条件码需要翻转
(cset (c2 (gpr-32 cond-code)) csinc (0 (zr 32) (zr 32) (invert-cond 1)))
(cset (c2 (gpr-64 cond-code)) csinc (0 (zr 64) (zr 64) (invert-cond 1)))

;; ------------------------------------------------------------
;; CSETM: (csetm Wd cond) -> (csinv Wd WZR WZR invert(cond))
;; ------------------------------------------------------------
;; CSETM 设置寄存器为 -1 (全 1) 如果条件成立，否则为 0
(csetm (c2 (gpr-32 cond-code)) csinv (0 (zr 32) (zr 32) (invert-cond 1)))
(csetm (c2 (gpr-64 cond-code)) csinv (0 (zr 64) (zr 64) (invert-cond 1)))
