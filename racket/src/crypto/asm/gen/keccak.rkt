#lang racket/base

;; asm/gen/keccak.rkt — Keccak 内核发射器
;; (Phase F: gen_keccak_absorb.py + gen_keccak_f2.py 的 asmp 化替代——
;;  两个 Python 脚本复制粘贴的 24 轮置换体在此合并为一份 emit-round)
;;
;; 两种内核共用同一 ARMv8-SHA3 置换体 (eor3/rax1/xar/bcax, mov-free rho/pi):
;;  - absorb: 每 rate 一个融合吸收内核 (SHAKE128/SHA3-224/256/384/512),
;;    1600-bit 态驻留向量寄存器跨全部块, rate 字直接 XOR 进寄存器态原地置换,
;;    无逐块 ctx<->state 往返。ld1r 广播载入 (单态占双 lane)。
;;    ABI: keccak_absorb<W>_asm(uint64_t st[25], const uint8_t*data,
;;                              long nblk, const uint64_t rc[24])
;;  - f2: 2 路批处理 Keccak-f[1600]——SHA3 指令天然作用于 128-bit 向量 =
;;    两条独立 64-bit lane, 同一置换免费跑两个态 (lane-major 交错载入)。
;;    供 SLH-DSA 批量 WOTS+/FORS 链。ABI: keccak_f2_asm(st[50], rc[24])
;;
;; 用法: [RKTASM=<rktasm 路径>] racket asm/gen/keccak.rkt {absorb|f2} <out.asm>
;;
;; 注意: keccak(absorb) 在 regen.sh KNOWN_DRIFT 白名单 (当前 asmp 分配器
;; 慢 2~5%), 已提交 .S 不可由 regen 重写——本发射器只承担 .asm 真源。

(require racket/list
         "gw.rkt")

(provide emit-absorb emit-f2)

;; rho/pi 环 (dst-lane, dst-theta-col, rot), 逆序走环使 pi 无需暂存
(define CYCLE
  '((10 1 63) (7 0 61) (11 2 58) (17 1 54) (18 2 49) (3 3 43) (5 3 36) (16 0 28)
    (8 1 19) (21 3 9) (24 1 62) (4 4 50) (15 4 37) (23 0 23) (19 3 8) (13 4 56)
    (12 3 39) (2 2 21) (20 2 2) (14 0 46) (22 4 25) (9 2 3) (6 4 44) (1 1 20)))

;; theta 列奇偶差 t* 的复用槽位 (rax1 后 t5/t6/t1/t2/t3 = D[0..4])
(define D-slot #(t5 t6 t1 t2 t3))

(define (ln i [elem "16b"]) (rv (string->symbol (format "ln~a" i)) elem))
(define (tv i [elem "16b"]) (rv (string->symbol (format "t~a" i)) elem))
(define (dv col [elem "2d"]) (rv (vector-ref D-slot col) elem))

;; 24 轮置换的一轮体 (theta + rho/pi + chi + iota), absorb/f2 逐字节同一份
(define (emit-round)
  (append
   ;; theta: 五列奇偶
   (append*
    (for/list ([c (in-range 5)])
      (list (ins 'eor3 (tv c) (ln c) (ln (+ c 5)) (ln (+ c 10)))
            (ins 'eor3 (tv c) (tv c) (ln (+ c 15)) (ln (+ c 20))))))
   (list (ins 'rax1 (tv 5 "2d") (tv 4 "2d") (tv 1 "2d"))
         (ins 'rax1 (tv 6 "2d") (tv 0 "2d") (tv 2 "2d"))
         (ins 'rax1 (tv 1 "2d") (tv 1 "2d") (tv 3 "2d"))
         (ins 'rax1 (tv 2 "2d") (tv 2 "2d") (tv 4 "2d"))
         (ins 'rax1 (tv 3 "2d") (tv 3 "2d") (tv 0 "2d"))
         (ins 'eor (ln 0) (ln 0) (tv 5))
         (ins 'mov (tv 0) (ln 1)))
   ;; rho/pi: 逆序走环, ln1 已暂存进 t0
   (for/list ([i (in-range (- (length CYCLE) 1) 0 -1)])
     (define dst (list-ref CYCLE i))
     (define src (first (list-ref CYCLE (- i 1))))
     (ins 'xar (ln (first dst) "2d") (ln src "2d")
          (dv (second dst)) (im (third dst))))
   (let ([dst0 (first CYCLE)])
     (list (ins 'xar (ln (first dst0) "2d") (tv 0 "2d")
                (dv (second dst0)) (im (third dst0)))))
   ;; chi: 每行 5 lane, t5/t6 暂存行首两 lane
   (append*
    (for/list ([base (in-list '(0 5 10 15 20))])
      (define-values (b0 b1 b2 b3 b4)
        (values base (+ base 1) (+ base 2) (+ base 3) (+ base 4)))
      (list (ins 'mov (tv 5) (ln b0))
            (ins 'mov (tv 6) (ln b1))
            (ins 'bcax (ln b0) (tv 5) (ln b2) (tv 6))
            (ins 'bcax (ln b1) (tv 6) (ln b3) (ln b2))
            (ins 'bcax (ln b2) (ln b2) (ln b4) (ln b3))
            (ins 'bcax (ln b3) (ln b3) (tv 5) (ln b4))
            (ins 'bcax (ln b4) (ln b4) (tv 6) (tv 5)))))
   ;; iota: RC 双 lane 广播 XOR 进 ln0
   (list (ins 'add (rx 'rcp) (rx 'rc) (rx 'i))
         (ins 'ld1r (regs (tv 0 "2d")) (mem (rx 'rcp)))
         (ins 'eor (ln 0) (ln 0) (tv 0))
         (ins 'add (rx 'i) (rx 'i) (im 8))
         (ins 'cmp (rx 'i) (im 192))
         (ins 'b #:suffix 'lt (lab 'round)))))

;; 融合吸收内核, 每 rate 一个
(define (emit-absorb-kernel W)
  (append
   (list (fn-begin (string->symbol (format "keccak_absorb~a_asm" W))
                   #:export? #t
                   #:in (list (rx 'st) (rx 'data) (rx 'nblk) (rx 'rc)))
         (lbl 'entry)
         (save-all))
   (for/list ([i (in-range 25)])
     (ins 'ld1r (regs (ln i "2d")) (mem-post (rx 'st) 8)))
   (list (ins 'sub (rx 'st) (rx 'st) (im 200))
         (lbl 'block))
   (append*
    (for/list ([w (in-range W)])
      (list (ins 'ld1r (regs (tv 0 "2d")) (mem-post (rx 'data) 8))
            (ins 'eor (ln w) (ln w) (tv 0)))))
   (list (ins 'mov (rx 'i) xzr)
         (lbl 'round))
   (emit-round)
   (list (ins 'subs (rx 'nblk) (rx 'nblk) (im 1))
         (ins 'b #:suffix 'ne (lab 'block)))
   (for/list ([i (in-range 25)])
     (ins 'st1 (regs (ln i "1d")) (mem-post (rx 'st) 8)))
   (list (restore-all)
         (ins 'ret)
         (fn-end))))

;; SHAKE128, SHA3-224, SHA3-256/SHAKE256, SHA3-384, SHA3-512
(define RATES '(21 18 17 13 9))

(define (emit-absorb)
  (append
   (list (rem "GENERATED by asm/gen/keccak.rkt absorb -- do not edit by hand."))
   (append*
    (for/list ([W (in-list RATES)])
      (append (emit-absorb-kernel W) (list blank))))))

;; 2 路批处理 f[1600]: lane-major 双态, 一次置换跑两条 lane
(define (emit-f2)
  (append
   (list (doc "2-way batched Keccak-f[1600] (lane-major interleaved: st[2i]=lane0 word i,"
              "st[2i+1]=lane1 word i). One call runs a full 24-round permutation on both"
              "lanes via eor3/rax1/xar/bcax. ~62 ns/lane. Routed from SLH-DSA (rktcrypto_slhdsa.c)."))
   (list (rem "GENERATED by asm/gen/keccak.rkt f2 -- do not edit by hand."))
   (list (fn-begin 'keccak_f2_asm #:export? #t
                   #:in (list (rx 'st) (rx 'rc)))
         (lbl 'entry)
         (save-all))
   (for/list ([i (in-range 25)])
     (ins 'ld1 (regs (ln i "2d")) (mem-post (rx 'st) 16)))
   (list (ins 'sub (rx 'st) (rx 'st) (im 400))
         (ins 'mov (rx 'i) xzr)
         (lbl 'round))
   (emit-round)
   (for/list ([i (in-range 25)])
     (ins 'st1 (regs (ln i "2d")) (mem-post (rx 'st) 16)))
   (list (restore-all)
         (ins 'ret)
         (fn-end)
         blank)))

(module+ main
  (define argv (current-command-line-arguments))
  (unless (= (vector-length argv) 2)
    (error 'keccak "usage: racket asm/gen/keccak.rkt {absorb|f2} <out.asm>"))
  (define mode (vector-ref argv 0))
  (define out (vector-ref argv 1))
  (define program
    (case mode
      [("absorb") (emit-absorb)]
      [("f2") (emit-f2)]
      [else (error 'keccak "mode must be absorb or f2, got: ~a" mode)]))
  (write-gnu-program out program)
  (printf "wrote keccak ~a\n" mode))
